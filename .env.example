# Sao chép file này thành .env.local rồi điền giá trị thật khi bắt đầu nối backend (Tuần 3+).
# Ở bản UI hiện tại (Tuần 1), toàn bộ dữ liệu là mock — chưa cần các biến này để chạy `npm run dev`.

# Supabase (Tuần 3: database + auth)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase phía server (dùng @supabase/server) — KHÔNG prefix NEXT_PUBLIC_,
# chỉ server được dùng để đọc/ghi các bảng có RLS chặn client (vd. chat_conversations)
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_JWKS_URL=

# URL công khai của site, dùng cho magic link đăng nhập (Tuần 6) và metadata
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Make.com (Tuần 5: tự động hoá) — webhook nhận thông báo khi có yêu cầu báo giá mới
MAKE_QUOTE_WEBHOOK_URL=

# Make.com — webhook nhận thông báo khi admin duyệt một yêu cầu báo giá
MAKE_APPROVAL_WEBHOOK_URL=

# Link đăng nhập gửi cho khách khi yêu cầu được duyệt. Dùng link mẫu cho đến
# khi có trang /login thật (Tuần 6) — chỉ cần đổi giá trị này, không cần sửa
# code hay sửa gì ở Make.com.
QUOTE_APPROVAL_LOGIN_LINK=http://localhost:3000/login
